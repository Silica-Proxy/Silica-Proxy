{
  "title": "SilicaProxy Overview",
  "uid": "silicaproxy-overview",
  "schemaVersion": 39,
  "version": 4,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },

    {
      "id": 1,
      "title": "Application Up",
      "description": "Prometheus scrape status: 1 = the instance is responding, 0 = unreachable.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "up{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "up" }
      ]
    },
    {
      "id": 2,
      "title": "Uptime",
      "description": "Time elapsed since the JVM last restarted.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "process_uptime_seconds{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "uptime" }
      ]
    },
    {
      "id": 3,
      "title": "Decision Rate",
      "description": "Rate of security decisions (ALLOW + BLOCK), all verdicts combined.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))", "legendFormat": "decisions/s" }
      ]
    },
    {
      "id": 4,
      "title": "Block Rate",
      "description": "Share of BLOCK decisions over the last 15 minutes. Green < 5%, orange 5-15%, red >= 15%.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 15 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum(rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\",verdict=\"BLOCK\"}[15m])) / sum(rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\"}[15m]))",
          "legendFormat": "block %"
        }
      ]
    },
    {
      "id": 5,
      "title": "Security Bypass (1h)",
      "description": "Requests of an unknown ecosystem relayed without any security check in the last hour (the proxy's blind spot). Should stay at 0. Metadata/index traffic of known ecosystems (packuments, simple index, maven-metadata...) is expected and not counted here.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(silicaproxy_controller_security_bypass_total{job=\"silicaproxy\", instance=~\"$instance\", ecosystem=\"unknown\"}[1h])) or vector(0)", "legendFormat": "bypass (1h)" }
      ]
    },
    {
      "id": 6,
      "title": "OSV Incremental Sync Freshness (hourly)",
      "description": "Seconds since the last successful hourly OSV incremental sync (npm/pypi/maven). A high value signals a stuck or failing scheduler. Covers only sync_type=\"incremental\" -- see \"OSV Full Sync Freshness\" for the nightly cron.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 21600,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5400 }, { "color": "red", "value": 10800 }] }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "silicaproxy_vulnerability_sync_seconds_since_last_success{job=\"silicaproxy\", instance=~\"$instance\", sync_type=\"incremental\"}", "legendFormat": "{{ecosystem}}" }
      ]
    },
    {
      "id": 8,
      "title": "OSV Full Sync Freshness (nightly cron)",
      "description": "Seconds since the last successful nightly full sync (OSV npm/pypi/maven zips + GHSA/OpenSSF/GitLab git advisories, 2am cron). Expected to grow to ~24h between runs, unlike the hourly incremental sync above. Covers sync_type=\"full\".",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 172800,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 108000 }, { "color": "red", "value": 129600 }] }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "silicaproxy_vulnerability_sync_seconds_since_last_success{job=\"silicaproxy\", instance=~\"$instance\", sync_type=\"full\"}", "legendFormat": "{{ecosystem}}" }
      ]
    },
    {
      "id": 9,
      "title": "MITM CA Certificate Expiry",
      "description": "Time remaining before the MITM CA certificate expires (generated with a 10-year validity, see MitmCertificateFactory). Once it expires, TLS interception breaks for every client that trusts it. Also exposed at /actuator/health as the \"caCertificate\" component (DEGRADED under 30 days, DOWN once expired).",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 7776000,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 2592000 }, { "color": "green", "value": 5184000 }] }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "silicaproxy_ssl_mitm_ca_seconds_until_expiry{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "CA expiry" }
      ]
    },
    {
      "id": 7,
      "title": "GitOps Sync Freshness",
      "description": "Seconds since the last successful GitOps sync (enterprise governance rules).",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "max": 3600,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 900 }, { "color": "red", "value": 1800 }] }
        }
      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "silicaproxy_gitops_sync_seconds_since_last_success{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "GitOps" }
      ]
    },
    {
      "id": 14,
      "title": "Checksum Mismatch (1h)",
      "description": "Downloads identified from the upstream response digest whose body did not match the announced digest, in the last hour: the connection was cut. Should stay at 0 -- a non-zero value means a tampered or corrupted artifact upstream.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 9, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(silicaproxy_identification_checksum_mismatch_total{job=\"silicaproxy\", instance=~\"$instance\"}[1h])) or vector(0)", "legendFormat": "mismatch (1h)" }
      ]
    },
    {
      "id": 15,
      "title": "Quarantine Skipped -- Unresolved Publish Date (1h)",
      "description": "Packages ALLOWED in the last hour although their publish date could not be found, so the quarantine age check was skipped (silicaproxy.quarantine.fail-open=true). Should stay at 0. Unresolved dates that ended in a BLOCK are not counted here.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 9, "x": 9, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(increase(silicaproxy_quarantine_publish_date_unresolved_total{job=\"silicaproxy\", instance=~\"$instance\", verdict=\"ALLOW\"}[1h])) or vector(0)", "legendFormat": "skipped (1h)" }
      ]
    },

    { "id": 101, "type": "row", "title": "Latency & Infra Health", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "panels": [] },

    {
      "id": 10,
      "title": "Security Overhead (avg / p50 / p95) by Decision",
      "description": "Time spent in security checks only (excluding binary relay), by allow/block verdict: average, median and 95th percentile.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (decision) (rate(silicaproxy_controller_security_overhead_seconds_sum{job=\"silicaproxy\", instance=~\"$instance\"}[5m])) / sum by (decision) (rate(silicaproxy_controller_security_overhead_seconds_count{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{decision}} avg"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "silicaproxy_controller_security_overhead_seconds{job=\"silicaproxy\", instance=~\"$instance\",quantile=\"0.5\"}",
          "legendFormat": "{{decision}} p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "silicaproxy_controller_security_overhead_seconds{job=\"silicaproxy\", instance=~\"$instance\",quantile=\"0.95\"}",
          "legendFormat": "{{decision}} p95"
        }
      ]
    },
    {
      "id": 11,
      "title": "TLS MITM Handshake (avg / p50 / p95)",
      "description": "Duration of the TLS handshake during MITM interception: average, median and 95th percentile.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(silicaproxy_loom_ssl_handshake_seconds_sum{job=\"silicaproxy\", instance=~\"$instance\"}[5m]) / rate(silicaproxy_loom_ssl_handshake_seconds_count{job=\"silicaproxy\", instance=~\"$instance\"}[5m])",
          "legendFormat": "handshake avg"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "silicaproxy_loom_ssl_handshake_seconds{job=\"silicaproxy\", instance=~\"$instance\",quantile=\"0.5\"}",
          "legendFormat": "handshake p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "silicaproxy_loom_ssl_handshake_seconds{job=\"silicaproxy\", instance=~\"$instance\",quantile=\"0.95\"}",
          "legendFormat": "handshake p95"
        }
      ]
    },
    {
      "id": 12,
      "title": "HikariCP Connection Pool",
      "description": "PostgreSQL connection pool occupancy. 'pending' > 0 signals pool saturation.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_active{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "active" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_idle{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "idle" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_pending{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "pending" },
        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "hikaricp_connections_max{job=\"silicaproxy\", instance=~\"$instance\"}", "legendFormat": "max" }
      ]
    },
    {
      "id": 13,
      "title": "JVM Threads (by state)",
      "description": "Number of JVM threads by state (runnable, waiting, blocked...). Virtual threads are not counted individually.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_states_threads{job=\"silicaproxy\", instance=~\"$instance\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },

    { "id": 102, "type": "row", "title": "Decisions & Cache", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }, "panels": [] },

    {
      "id": 20,
      "title": "Decisions by Verdict",
      "description": "Rate of ALLOW vs BLOCK decisions over time.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (verdict) (rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{verdict}}"
        }
      ]
    },
    {
      "id": 21,
      "title": "Local Decision Evaluation (HIT/MISS)",
      "description": "DecisionDao.evaluateDecision() checks 3 local sources in a single SQL query: company policy, the locally-synced public vulnerability data (OSV, kept up to date by OsvIncrementalSyncService, not a live call), and api_cache (a still-valid verdict from a previous external call). A HIT means one of the three matched and the verdict is returned with no network call. A MISS means the package/version is unknown to all three, so SecurityService falls through to a registry metadata lookup and then a live OSV/deps.dev fallback check.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(silicaproxy_decision_local_evaluation_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Decision Rate by Instance (HAProxy Load-Balancing Check)",
      "description": "Compares decision throughput across instances to verify HAProxy load balancing.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 23,
      "title": "Block Evolution by Type",
      "description": "Rate of BLOCK decisions over time, broken down by source: COMPANY_POLICY, PUBLIC_VULN / PUBLIC_VULN_MALWARE / PUBLIC_VULN_ANOMALY (locally-synced OSV data), API_CACHE, REGISTRY_QUARANTINE / REGISTRY_DEPRECATION / REGISTRY_NOT_FOUND / REGISTRY_ERROR, EXTERNAL_VALIDATION, OSV_LIVE / DEPS_DEV / API_FALLBACK_ERROR (live fallback), or UNIDENTIFIED_ARTIFACT (package tarball whose name/version could not be identified).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (source) (rate(silicaproxy_controller_decisions_total{job=\"silicaproxy\", instance=~\"$instance\", verdict=\"BLOCK\"}[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },

    { "id": 109, "type": "row", "title": "Identification & Quarantine", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }, "panels": [] },

    {
      "id": 24,
      "title": "Security Bypass by Ecosystem",
      "description": "Requests relayed without a security decision, by ecosystem. Under a known ecosystem this is expected metadata/index traffic (packuments, simple index, maven-metadata...); ecosystem=unknown is the blind spot also shown in the Security Bypass stat.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (ecosystem) (rate(silicaproxy_controller_security_bypass_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{ecosystem}}"
        }
      ]
    },
    {
      "id": 25,
      "title": "Identification from Upstream Response",
      "description": "Unidentified requests looked up by the digest announced in the upstream response, by outcome: identified (deps.dev), identified_from_database (local digest index), not_found, ambiguous, unavailable (deps.dev error) or skipped (not a package file / no usable digest).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(silicaproxy_identification_response_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 26,
      "title": "Quarantine Publish Date Source",
      "description": "Where the publish date used by the quarantine age check came from: PUBLIC_REGISTRY (trusted), ORIGIN_REGISTRY (the registry the client asked, less trusted), LOCAL_CACHE (registry unreachable), LOCAL_CACHE_NO_LOOKUP (registry not queried, the cached date being enough) or UNRESOLVED (no date at all, see the Quarantine Skipped stat).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (source) (rate(silicaproxy_quarantine_publish_date_lookups_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{source}}"
        }
      ]
    },

    { "id": 103, "type": "row", "title": "External Dependencies", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 }, "panels": [] },

    {
      "id": 30,
      "title": "External Security API Calls (OSV live / deps.dev)",
      "description": "Outbound calls to OSV live and deps.dev when evaluating packages unknown to the local cache, by result.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (source, result) (rate(silicaproxy_external_api_calls_total{job=\"silicaproxy\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{source}} - {{result}}"
        }
      ]
    },
    {
      "id": 31,
      "title": "External Validation Calls (sync/async)",
      "description": "Calls to configured external validation scanners, in synchronous (blocking) or asynchronous (fire-and-forget) mode.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },

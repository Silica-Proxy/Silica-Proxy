# Copy to .env and fill in the required values before running `docker compose up -d`.

# --- Required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
SILICAPROXY_SSL_MITM_CA_KEYSTORE_PASSWORD=change-me
# Bearer key for the REST API endpoints with side effects (forced sync...); also unlocks READ ones
SILICAPROXY_API_KEY_ACTION=change-me-action

# --- Optional -------------------------------------------------------------------------------
#SILICAPROXY_IMAGE=silicaproxy/silicaproxy:latest

# Company policies (GitOps): a Git repository with npm.yaml, pypi.yaml and maven.yaml at its root.
# Both lines are needed; without them the proxy runs every other check, with no company policy.
#SILICAPROXY_GITOPS_ENABLED=true
#SILICAPROXY_GITOPS_REPOSITORY_URL=https://git.example.com/devops/policies.git
#SILICAPROXY_GITOPS_CLONE_TOKEN=
# Separate bearer key for the read-only REST API endpoints (empty = only the action key works)
#SILICAPROXY_API_KEY_READ=
#SILICAPROXY_GITOPS_SYNC_INTERVAL_MINUTES=10
#SILICAPROXY_PROXY_PORT=8080
#SILICAPROXY_MEMORY_LIMIT=2g
#SILICAPROXY_LOG_LEVEL=INFO
#SILICAPROXY_QUARANTINE_FAIL_OPEN=true
#SILICAPROXY_API_CALL_LOG_ENABLED=false
#POSTGRES_MEMORY_LIMIT=1g

# --- External scanners (docs/advanced-setup.md) ----------------------------------------------
# Compose files to use, so that a plain `docker compose up -d` includes the scanners
# (separator ":" on Linux/macOS, ";" on Windows):
#COMPOSE_FILE=compose.yaml:compose.packagenameguardian.yaml:compose.packagebehaviorguardian.yaml

# compose.packagenameguardian.yaml
#PACKAGENAMEGUARDIAN_API_KEY=change-me

# compose.packagebehaviorguardian.yaml
#PACKAGEBEHAVIORGUARDIAN_API_KEY=change-me
# Observation mode by default; set BLOCKING=true and FAIL_OPEN=false to enforce its verdicts
#PACKAGEBEHAVIORGUARDIAN_BLOCKING=false
#PACKAGEBEHAVIORGUARDIAN_FAIL_OPEN=true

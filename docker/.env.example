# Copy to .env and fill in the required values before running `docker compose up -d`.

# --- Required -------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
SILICAPROXY_GITOPS_REPOSITORY_URL=https://git.yourcompany.com/devops/policies.git
SILICAPROXY_SSL_MITM_CA_KEYSTORE_PASSWORD=change-me
# Bearer key for the REST API endpoints with side effects (forced sync...); also unlocks READ ones
SILICAPROXY_API_KEY_ACTION=change-me-action

# --- Optional -------------------------------------------------------------------------------
#SILICAPROXY_IMAGE=silicaproxy/silicaproxy:latest
#SILICAPROXY_GITOPS_CLONE_TOKEN=
# Separate bearer key for the read-only REST API endpoints (empty = only the action key works)
#SILICAPROXY_API_KEY_READ=
#SILICAPROXY_GITOPS_SYNC_INTERVAL_MINUTES=10
#SILICAPROXY_PROXY_PORT=8080
#SILICAPROXY_MEMORY_LIMIT=2g
#SILICAPROXY_LOG_LEVEL=INFO
#SILICAPROXY_QUARANTINE_FAIL_OPEN=true
#SILICAPROXY_API_CALL_LOG_ENABLED=false
#POSTGRES_MEMORY_LIMIT=1g

# --- PackageNameGuardian (profile "packagenameguardian") ------------------------------------
# The service is reached on the private Docker network, which the SSRF protection blocks.
#PACKAGENAMEGUARDIAN_ENABLED=true
#SILICAPROXY_SECURITY_SSRF_PROTECTION_ENABLED=false
#PACKAGENAMEGUARDIAN_API_KEY=change-me
#PACKAGENAMEGUARDIAN_IMAGE=silicaproxy/packagenameguardian:latest
#PACKAGENAMEGUARDIAN_PORT=8100

